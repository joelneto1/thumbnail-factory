# ─── G-Labs (engine de IMAGEM — Nano Banana Pro) ───────────────────────
# Local (sua máquina, Chrome + extensão):  http://127.0.0.1:8765
# VPS via Tailscale Serve (deploy):         https://joel.tail739437.ts.net
GLABS_BASE_URL=http://127.0.0.1:8765
GLABS_API_KEY=

# ─── ChatGPT Image Auto (2º provedor de GPT Image 2, para a cascata) ────
# Servidor da fila que roda no MESMO PC dos perfis do Chrome.
# Local (sua máquina):      http://localhost:3900
# VPS via Tailscale:        http://100.98.183.1:3900
# A chave é a mesma do campo `apiKey` em server/accounts.json.
CHATGPT_AUTO_BASE_URL=http://100.98.183.1:3900
CHATGPT_AUTO_API_KEY=

# ─── CLI Proxy (Claude Opus 4.8 — TEXTO + VISÃO, OpenAI-compatible) ─────
# Prompt assist + análise de thumbnail concorrente.
CLI_PROXY_BASE_URL=http://cli-proxyllm.rotaclubs.com/v1
CLI_PROXY_API_KEY=
CLI_PROXY_MODEL=claude-opus-4-8
CLI_PROXY_REASONING_EFFORT=high

# ─── AUTENTICAÇÃO (obrigatório) ────────────────────────────────────────
# Sem as três, o app nega TODO acesso — falha fechada, de propósito.
#
# AUTH_PASSWORD_HASH é scrypt, no formato `scrypt:<salt>:<hash>`.
# O separador é `:` e não `$` — env loaders e o Docker Compose expandem `$NOME`
# como variável, o que apagaria metade do hash sem dar erro nenhum.
# Para gerar um par novo (senha aleatória + hash + segredo):
#   node scripts/gen-credentials.mjs
#
# NUNCA coloque valores reais neste arquivo — ele é versionado e o repo é público.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
# Segredo de assinatura do JWT de sessão. Mínimo 32 caracteres.
# Trocar este valor invalida todas as sessões abertas.
AUTH_SECRET=

# ─── UI ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Thumbnail Factory
